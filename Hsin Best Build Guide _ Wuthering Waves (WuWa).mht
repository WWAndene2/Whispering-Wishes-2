@charset "utf-8";

.pw-filter-dropdown { min-width: 180px; display: inline-flex; position: relative; }

.pw-filter-dropdown-toggle { width: 100%; height: 40px; color: var(--color-text-default,#fff); cursor: pointer; text-align: left; background-color: rgb(44, 45, 51); border: 1px solid rgb(51, 52, 58); border-radius: 4px; justify-content: space-between; align-items: center; gap: 10px; padding: 7px 14px; font-size: 14px; display: flex; }

.pw-filter-dropdown-toggle:hover, .pw-filter-dropdown.open .pw-filter-dropdown-toggle { background-color: rgb(54, 55, 61); border-color: rgb(74, 75, 82); }

.pw-filter-dropdown-toggle svg { opacity: 0.7; flex-shrink: 0; transition: transform 0.15s; }

.pw-filter-dropdown.open .pw-filter-dropdown-toggle svg { transform: rotate(180deg); }

.pw-filter-dropdown-label { white-space: nowrap; text-overflow: ellipsis; flex: 1 1 auto; overflow: hidden; }

.pw-filter-dropdown-menu { z-index: 1000; background-color: rgb(44, 45, 51); border: 1px solid rgb(74, 75, 82); border-radius: 4px; max-height: 360px; margin: 0px; padding: 4px 0px; list-style: none; position: absolute; top: calc(100% + 4px); left: 0px; right: 0px; overflow-y: auto; box-shadow: rgba(0, 0, 0, 0.4) 0px 4px 12px; }

.pw-filter-dropdown-option { color: var(--color-text-default,#fff); cursor: pointer; user-select: none; white-space: nowrap; text-overflow: ellipsis; outline: none; padding: 8px 14px; font-size: 14px; overflow: hidden; }

.pw-filter-dropdown-option:hover, .pw-filter-dropdown-option:focus-visible { background-color: rgb(58, 59, 66); }

.pw-filter-dropdown-option.active { color: rgb(255, 255, 255); background-color: rgb(31, 143, 217); }

.pw-filter-dropdown-option.active:hover, .pw-filter-dropdown-option.active:focus-visible { background-color: rgb(26, 125, 191); }
