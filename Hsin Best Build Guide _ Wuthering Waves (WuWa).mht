.bookmark-btn { --size: 36px; width: var(--size); height: var(--size); border: 1px solid var(--color-border,#fff3); backdrop-filter: blur(4px); color: var(--color-text-lighter,#cbd5e1); cursor: pointer; background: rgba(20, 22, 28, 0.55); border-radius: 999px; flex-shrink: 0; justify-content: center; align-items: center; margin-left: 10px; font-size: 14px; transition: transform 0.15s, background-color 0.15s, border-color 0.15s, box-shadow 0.15s, color 0.15s; display: inline-flex; }

.bookmark-btn:hover:not(:disabled) { border-color: var(--color-brand-warning,#f0a020); color: var(--color-brand-warning,#f0a020); transform: scale(1.06); }

.bookmark-btn:active:not(:disabled) { transform: scale(0.92); }

.bookmark-btn:disabled { opacity: 0.6; cursor: default; }

.bookmark-btn.is-active { background: linear-gradient(145deg, #ffcf6b, var(--color-brand-warning,#f0a020)); color: var(--color-text-dark,#191817); box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-brand-warning,#f0a020) 18%, transparent), 0 4px 14px color-mix(in srgb, var(--color-brand-warning,#f0a020) 35%, transparent); border-color: rgba(0, 0, 0, 0); }

.bookmark-btn.is-active:hover:not(:disabled) { transform: scale(1.06); }
