@charset "utf-8";

.ww-weapons-page .banner { background-size: cover; border: 1px solid rgb(51, 52, 58); justify-content: center; align-items: center; height: 170px; margin-top: 15px; margin-bottom: 15px; padding: 25px; display: flex; }

@media (max-width: 992px) {
  .ww-weapons-page .banner { text-align: center; flex-direction: column; justify-content: center; height: auto; }
  .ww-weapons-page .banner .pw-btn { margin-top: 10px; }
}

.ww-weapons-page .banner h4 { margin-bottom: 0px; font-size: 34px; }

@media (max-width: 992px) {
  .ww-weapons-page .banner h4 { font-size: 26px; }
}

.ww-weapons-page .banner p { margin-bottom: 0px; }

.ww-weapons-page .banner .cta { text-align: center; }

.ww-weapons-page .rarity-ww.rar-1 { color: rgb(199, 199, 199); }

.ww-weapons-page .rarity-ww.rar-2 { color: rgb(156, 243, 176); }

.ww-weapons-page .rarity-ww.rar-3 { color: rgb(169, 238, 255); }

.ww-weapons-page .rarity-ww.rar-4 { color: rgb(255, 190, 253); }

.ww-weapons-page .rarity-ww.rar-5 { color: rgb(234, 226, 135); }

.ww-weapons-page .pw-form-control { font-size: 15px; }

.ww-weapons-page .weapon-filter { gap: 5px; grid-template-columns: repeat(auto-fill, 16.3%); justify-content: space-between; margin-top: 10px; margin-bottom: 10px; display: grid; }

@media (max-width: 1420px) {
  .ww-weapons-page .weapon-filter { gap: 5px 0px; grid-template-columns: repeat(auto-fill, 49.5%); }
}

.ww-weapons-page .weapon-filter .option { opacity: 0.5; cursor: pointer; text-align: center; border: 2px solid rgb(51, 52, 58); justify-content: center; align-items: center; height: 100px; transition: 0.7s; display: flex; }

@media (max-width: 992px) {
  .ww-weapons-page .weapon-filter .option { height: 80px; }
}

.ww-weapons-page .weapon-filter .option h6 { text-shadow: rgb(28, 29, 33) 2px 2px 2px; margin-bottom: 0px; font-size: 20px; font-weight: 600; }

@media (max-width: 1200px) {
  .ww-weapons-page .weapon-filter .option h6 { font-size: 16px; }
}

@media (max-width: 992px) {
  .ww-weapons-page .weapon-filter .option h6 { font-size: 15px; }
}

.ww-weapons-page .weapon-filter .option.all { background-image: url("https://cdn.prydwen.gg/images/wuthering-waves/weapon_all_cat.webp"); background-position: 50% center; }

.ww-weapons-page .weapon-filter .option.Broadblade { background-image: url("https://cdn.prydwen.gg/images/wuthering-waves/weapon_sword_cat.webp"); background-position: 50% center; }

.ww-weapons-page .weapon-filter .option.Sword { background-image: url("https://cdn.prydwen.gg/images/wuthering-waves/weapon_broad_cat.webp"); background-position: 50% center; }

.ww-weapons-page .weapon-filter .option.Pistols { background-image: url("https://cdn.prydwen.gg/images/wuthering-waves/weapon_pistols_cat.webp"); background-position: 50% center; }

.ww-weapons-page .weapon-filter .option.Rectifier { background-image: url("https://cdn.prydwen.gg/images/wuthering-waves/weapon_rectifier_cat.webp"); background-position: 50% center; }

.ww-weapons-page .weapon-filter .option.Gauntlets { background-image: url("https://cdn.prydwen.gg/images/wuthering-waves/weapon_gauntlets_cat.webp"); background-position: 50% center; }

.ww-weapons-page .weapon-filter .option.selected { opacity: 1; border-color: rgb(0, 158, 236); }

.ww-weapons-page .weapon-filter .option.selected:hover { opacity: 1; }

.ww-weapons-page .weapon-filter .option:hover { opacity: 0.8; transition: 0.7s; }

.ww-weapons-page .stats-header { gap: 5px; grid-template-columns: 50% 50%; justify-content: space-between; align-items: center; width: 100%; margin-bottom: 10px; display: grid; }

.ww-weapons-page .stats-header .info { align-items: center; display: flex; }

.ww-weapons-page .stats-header .info p { text-transform: uppercase; margin-bottom: 0px; font-size: 15px; font-weight: 500; }

.ww-weapons-page .stats-header .info p strong { color: rgb(255, 215, 128); }

.ww-weapons-page .stats-header .level-changer { align-items: center; padding: 5px 10px; display: flex; }

@media (max-width: 1200px) {
  .ww-weapons-page .stats-header .level-changer { padding-left: 0px; }
}

.ww-weapons-page .stats-header .level-changer .current-level { width: 60px; font-size: 15px; font-weight: 400; line-height: 15px; }

.ww-weapons-page .stats-header .level-changer .current-level .level { color: rgb(255, 215, 128); font-weight: 500 !important; }

.ww-weapons-page .stats-header .level-changer .level-slider { width: 100%; }

.ww-weapons-page .stats-header .level-changer .level-slider.disabled { opacity: 0.3; cursor: not-allowed; }

@media (max-width: 1200px) {
  .ww-weapons-page .stats-header { text-align: center; grid-template-columns: 100%; }
}

.ww-weapons-page .ww-weapons-container { gap: 10px; grid-template-columns: 33% 33% 33%; justify-content: space-between; width: 100%; display: grid; }

@media (max-width: 1680px) {
  .ww-weapons-page .ww-weapons-container { grid-template-columns: 49% 49%; }
}

@media (max-width: 768px) {
  .ww-weapons-page .ww-weapons-container { grid-template-columns: 100%; }
}

.ww-weapons-page .ww-weapons-container .box { height: 100%; }
