.section-header { border-bottom: 2px solid rgb(38, 146, 211); margin: 25px 0px 15px; padding-bottom: 6px; }

.section-header h2 { text-transform: uppercase; margin-bottom: 0px; font-size: 20px; font-weight: 600; line-height: 20px; }

@media (max-width: 576px) {
  .section-header h2 { font-size: 18px; line-height: 26px; }
}

.section-header .additional-text { color: rgba(255, 255, 255, 0.55); padding-left: 8px; font-size: 14px; font-weight: 500; line-height: 14px; }

.section-header.with-control { align-items: center; display: flex; }

