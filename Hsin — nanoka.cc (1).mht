  :where(.ui-section--surface, .ui-section--toolbar, .ui-section--feature) { padding: var(--space-4); }
  :where(.ui-section--hero) { min-height: 24rem; padding: var(--space-4); }
  :where(.ui-filter-select) { width: 100%; }
  :where(.ui-page-header, .ui-section-header) { gap: var(--space-2); }
  :where(.ui-table-frame) { max-width: 100%; }
  :where(.ui-table-frame) table { font-size: 0.75rem; }
  :where(.ui-filter-options--scroll) { max-block-size: min(18rem, 45svh); }
  :where(.ui-achievement-stats) { width: 100%; min-width: 0px; }
  :where(.ui-page-header:has(.ui-achievement-stats)) { flex-direction: column; align-items: stretch; }
  :where(.ui-page-header__actions:has(.ui-achievement-stats)) { width: 100%; }
  :where(.ui-achievement-controls) { display: grid; grid-template-columns: repeat(2, minmax(0px, 1fr)); align-items: stretch; }
  :where(.ui-achievement-controls) > * { width: 100%; }
  :where(.ui-achievement-controls) > :first-child { grid-column: 1 / -1; }
  :where(.ui-achievement-item__layout) { gap: var(--space-4); }
  :where(.ui-achievement-item__aside) { min-width: 3.5rem; }
  .ui-achievement-nav-toggle { display: flex; }
  :where(.ui-achievement-panel--navigator[data-expanded="false"]) { display: none; }
