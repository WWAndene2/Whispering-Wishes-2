  :where(.ui-season-row) { min-height: 0px; break-inside: avoid; grid-template-areas: "meta action" "body body" "period period"; grid-template-columns: minmax(0px, 1fr) auto; align-items: start; gap: var(--space-3); padding: 0.4rem 0px; border-color: rgb(184, 184, 184); background: transparent !important; color: rgb(17, 17, 17) !important; }
  :where(.ui-season-ledger__item) { break-inside: avoid; }
  :where(.ui-season-row)::before, :where(.ui-season-status)::before, :where(.ui-season-row__action)::after { display: none; }
  :where(.ui-season-row__meta) { align-items: center; flex-direction: row; justify-content: space-between; }
  :where(.ui-season-row__heading), :where(.ui-season-row__id), :where(.ui-season-row__period), :where(.ui-season-row__period-label), :where(.ui-season-row__action), :where(.ui-season-row__label), :where(.ui-season-status) { color: rgb(17, 17, 17) !important; opacity: 1; }
  :where(.ui-season-row__heading) { display: block !important; overflow: visible !important; -webkit-box-orient: initial !important; -webkit-line-clamp: initial !important; }
}
