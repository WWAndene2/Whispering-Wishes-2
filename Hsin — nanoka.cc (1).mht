  :root { --layout-gutter: var(--space-5); }
  .app-column { margin-left: var(--layout-sidebar); }
  .app-main, .site-main { padding-top: var(--space-6); }
  :where(.ui-section--surface, .ui-section--feature, .ui-section--hero) { padding: var(--space-5); }
  :where(.ui-section--toolbar) { padding: var(--space-5); }
  :where(.ui-content-grid--catalog) { grid-template-columns: repeat(4, minmax(0px, 1fr)); }
  :where(.ui-content-grid--cards) { grid-template-columns: repeat(2, minmax(0px, 1fr)); }
  :where(.ui-key-value-list--2) { grid-template-columns: repeat(2, minmax(0px, 1fr)); }
  :where(.ui-character-detail-tabs) { --detail-tabs-center: calc(50% + (var(--layout-sidebar) / 2)); --detail-tabs-inset: var(--layout-sidebar); }
  :where(.ui-filter-select) { max-width: 22rem; }
}

@media (min-width: 1024px) {
  :root { --layout-gutter: var(--space-6); }
  :where(.ui-content-grid--catalog) { grid-template-columns: repeat(6, minmax(0px, 1fr)); }
  :where(.ui-content-grid--wide) { grid-template-columns: repeat(2, minmax(0px, 1fr)); }
  :where(.ui-content-grid--wide.ui-achievement-workspace) { grid-template-columns: minmax(18rem, 0.72fr) minmax(0px, 1.28fr); }
}

@media (min-width: 1280px) {
  :where(.ui-content-grid--catalog) { grid-template-columns: repeat(7, minmax(0px, 1fr)); }
  :where(.ui-content-grid--wide.ui-achievement-workspace) { grid-template-columns: minmax(20rem, 0.62fr) minmax(0px, 1.38fr); }
  :where(.ui-content-grid--wide) > :where(.ui-character-hero) { position: sticky; top: var(--space-5); align-self: start; }
}

@media (min-width: 1536px) {
  :where(.ui-content-grid--catalog) { grid-template-columns: repeat(8, minmax(0px, 1fr)); }
}

@media (max-width: 639px) {
