@charset "utf-8";

html, body { margin: 0px; padding: 0px; color-scheme: dark; }

body { background: rgb(12, 8, 24); min-height: 100vh; }

#app-loading { position: fixed; inset: 0px; display: flex; align-items: center; justify-content: center; pointer-events: none; z-index: 9999; }

#app-loading-spinner { width: 64px; height: 4px; background: rgb(184, 146, 255); animation: 1s ease-in-out 0s infinite alternate none running _pulse; }

@keyframes _pulse { 
  100% { opacity: 0.35; transform: scaleX(0.45); }
}
