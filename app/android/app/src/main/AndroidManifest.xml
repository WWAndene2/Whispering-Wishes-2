<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Home-screen long-press App Shortcuts — see res/xml/shortcuts.xml and
                 PullBubbleShortcutActivity. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <!-- Deep-link catcher for the Cloud Backup Google Sign-In flow (see
                 CloudStorageProvider.jsx) — Google blocks its OAuth popup inside a WebView, so
                 on native the auth code comes back via a redirect instead of a same-page
                 callback, caught here and re-delivered to the JS side as an 'appUrlOpen' event
                 by @capacitor/app. The scheme is NOT the app's own custom_url_scheme — Google's
                 OAuth server only accepts the reversed-client-ID scheme for this client type
                 (Error 400: invalid_request otherwise), computed at build time from
                 VITE_GOOGLE_CLIENT_ID_NATIVE by build.gradle's own googleAuthRedirectScheme
                 (see its comment for why), and must exactly match what
                 CloudStorageProvider.jsx's getGoogleAccessTokenNative() builds at runtime from
                 that same env var. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${googleAuthRedirectScheme}" />
            </intent-filter>
        </activity>

        <!-- Pure trampoline target for the App Shortcut above — see its own file header.
             exported="true" is required: App Shortcuts are launched by the launcher app (a
             separate process), the same cross-app-caller reasoning as any Activity a launcher
             invokes directly. -->
        <activity
            android:name=".PullBubbleShortcutActivity"
            android:theme="@style/AppTheme.Trampoline"
            android:excludeFromRecents="true"
            android:exported="true" />

        <!-- Pure trampoline target for the "Quick Calc" App Shortcut — see its own file
             header. Same cross-app-caller reasoning as PullBubbleShortcutActivity above:
             App Shortcuts are launched by the launcher app (a separate process), so
             exported="true" is required. -->
        <activity
            android:name=".QuickCalcShortcutActivity"
            android:theme="@style/AppTheme.Trampoline"
            android:excludeFromRecents="true"
            android:exported="true" />

        <!-- Pure trampoline target for the "Quick Soundtrack" App Shortcut — see its own
             file header. Same reasoning as QuickCalcShortcutActivity above. -->
        <activity
            android:name=".QuickSoundtrackShortcutActivity"
            android:theme="@style/AppTheme.Trampoline"
            android:excludeFromRecents="true"
            android:exported="true" />

        <!-- Single adaptive Calculator widget — one AppWidgetProvider whose displayed
             sections react to its current placed size (width for row 1's currency-column
             reveal, height for which stacked sections exist at all), rather than several
             separate widgets. Same exported="true" requirement as the other widget
             receivers above; also needs to receive its own ACTION_SET_TARGET broadcast
             (the target-picker buttons' taps), which has no intent-filter here since it's
             only ever sent explicitly via PendingIntent.getBroadcast() targeting this
             exact component, not broadcast system-wide. -->
        <receiver
            android:name=".CalculatorWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calculator_widget_info" />
        </receiver>

        <!-- Soundtrack widget — plays the app's own ambient "Log Screen" music tracks. Same
             exported="true" requirement as the other widget receivers above; needs no extra
             intent-filter beyond APPWIDGET_UPDATE since its buttons talk directly to
             SoundtrackPlaybackService (PendingIntent.getService()), not back to this
             receiver. -->
        <receiver
            android:name=".SoundtrackWidget"
            android:exported="true"
            android:label="@string/frequency_cassette_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/soundtrack_widget_info" />
        </receiver>

        <!-- Real playback engine behind the Soundtrack widget above — see its own file header
             for why a genuine FOREGROUND service (foregroundServiceType="mediaPlayback",
             the standard type for this, unlike PullBubbleService's "specialUse") is required
             rather than a plain one. Toggled/skipped via PendingIntent.getService() from
             SoundtrackWidget's own buttons (our own app, so exported="false" is correct —
             same reasoning as every other plain Service in this file). -->
        <service
            android:name=".SoundtrackPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Small floating dialog opened via PendingIntent.getActivity() from
             CalculatorWidget's own row-1 currency taps — same cross-app-caller reasoning as
             ConveneAnimationActivity below (PendingIntents run with their creating app's
             identity regardless of exported), so exported="false" is correct. -->
        <activity
            android:name=".CurrencyInputActivity"
            android:theme="@style/AppTheme.WidgetInputDialog"
            android:exported="false"
            android:excludeFromRecents="true" />

        <activity
            android:name=".ConveneAnimationActivity"
            android:theme="@style/AppTheme.ConveneOverlay"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:configChanges="orientation|screenSize" />

        <!-- Plays the convene animation in a small floating, rounded window over the home
             screen (real VideoView, real quality/audio) — requested explicitly in place of
             a fullscreen Activity. Needs android.permission.SYSTEM_ALERT_WINDOW (declared
             below); falls back to ConveneAnimationActivity when that isn't granted or
             overlay playback fails for any reason — see the service's own file header.
             Started via PendingIntent.getService() from PullBubbleService's own sub-bubbles
             (our own app, so exported="false" is correct). Deliberately a PLAIN service, not
             a foreground one: the whole job is
             a few seconds of playback triggered directly by a user tap, which gets
             Android's short temporary background-execution allowance regardless of
             Doze/App-Standby. -->
        <service
            android:name=".FloatingVideoOverlayService"
            android:exported="false" />

        <!-- Chat-heads-style persistent floating pull bubble (see PullBubbleService's own file
             header for the full roll → sub-bubbles → floating video → dismissible result-icon
             flow).
             UNLIKE every other Service in this file, this one is a genuine, always-on
             FOREGROUND service (declared foregroundServiceType="specialUse" — a floating
             chat-heads-style bubble doesn't cleanly fit any of Android's other standard FGS
             types — with the required PROPERTY_SPECIAL_USE_FGS_SUBTYPE justification below)
             since it stays on screen until the user drags it onto its own ✕ target, not just
             for a few seconds after a tap. Needs android.permission.SYSTEM_ALERT_WINDOW
             (shared with FloatingVideoOverlayService above) plus FOREGROUND_SERVICE and (API
             34+) FOREGROUND_SERVICE_SPECIAL_USE, both declared below. Toggled on/off via
             PendingIntent.getService() from ProfileTab's own PullBubbleCard toggle
             (ACTION_TOGGLE), so exported="false" is correct — nothing outside this app ever
             starts it directly. -->
        <service
            android:name=".PullBubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent floating bubble the user explicitly enables to roll gacha pulls and play the result animation without switching apps; the user disables it by dragging it onto its own on-screen dismiss target." />
        </service>

        <!-- Real Android Live Wallpaper — renders a looping video onto the wallpaper surface
             via MediaPlayer (LiveVideoWallpaperService.Engine), unlike WallpaperPlugin's static
             WallpaperManager.setBitmap() which can never animate. Applied via
             WallpaperPlugin.setLiveWallpaper() firing ACTION_CHANGE_LIVE_WALLPAPER, which opens
             Android's own live-wallpaper confirmation screen naming this component — that
             system UI step is required and can't be skipped. BIND_WALLPAPER is a signature/
             system permission the OS itself holds, not something an app requests at runtime;
             declaring it here is what lets the system bind to this service as a wallpaper. -->
        <service
            android:name=".LiveVideoWallpaperService"
            android:exported="true"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/live_wallpaper" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Without this, navigator.vibrate()/@capacitor/haptics silently do nothing in the
         WebView — unlike a browser tab, an Android app needs this permission declared. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android 13+ (API 33) requires this runtime permission before any notification
         (including FCM push) can be shown — requested at runtime via
         PushNotifications.requestPermissions() in src/utils/pushNotifications.js. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "Draw over other apps" — required by FloatingVideoOverlayService's floating convene-
         animation window. NOT a normal runtime prompt: the user grants this manually via a
         dedicated system settings screen (FloatingVideoOverlayService.requestOverlayPermission()
         opens it), and Google Play requires a declared justification for apps using it. Until
         granted, playback falls back to the fullscreen ConveneAnimationActivity instead. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Required (API 28+) to run ANY foreground service — PullBubbleService's persistent
         floating bubble. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required (API 34+) specifically for a foregroundServiceType="specialUse" service —
         PullBubbleService, see its own manifest entry's comment for why "specialUse" rather
         than one of the other standard types. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Required (API 34+) specifically for a foregroundServiceType="mediaPlayback" service —
         SoundtrackPlaybackService. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Normal (not dangerous) permission — no runtime prompt needed, just this declaration.
         Required for WallpaperManager.setBitmap(), used by WallpaperPlugin to set a collection
         asset as the phone's home/lock screen wallpaper. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
</manifest>
